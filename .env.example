# Compose general de TicketYa. Copiar a .env (no se versiona) y completar los vacíos.
#
# Estas variables llegan a TODOS los compose incluidos y tienen prioridad sobre
# los .env de cada servicio. Por eso NO hay que agregar acá:
#   PORT, SERVER_PORT, PUERTO, DB_USER, DB_URL, DB_NAME, DB_HOST, DB_PORT
# (cada servicio usa valores distintos con el mismo nombre; se quedan con sus defaults).

# --- Compartidas por todos los servicios ---
# Token del header X-Service-Token, mismo valor en todos.
SERVICIO_TOKEN=
# Secreto del JWT: 32 caracteres o más, el mismo en el Gateway y en Usuarios.
JWT_SECRET=

# --- Bases de datos ---
# Compras, Notificaciones, Pagos, Entradas y Usuarios leen la misma variable
# DB_PASSWORD, así que comparten la contraseña (cada uno con su propia base).
DB_PASSWORD=
# Root de MySQL de Compras y Notificaciones.
MYSQL_ROOT_PASSWORD=
# MS2 Reservas
MS2_DB_PASSWORD=
MS2_MYSQL_ROOT_PASSWORD=
# MS7 Fila virtual
MS7_DB_PASSWORD=
MS7_MYSQL_ROOT_PASSWORD=

# --- URLs y servicios sin un default útil ---
# MS1 -> MS6 (personal de acceso)
USUARIOS_BASE_URL=http://usuarios:8087
# MS9 -> Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025

# --- MS6 Usuarios ---
# Administrador inicial que se crea al arrancar. Contraseña de 8 caracteres o más, con letras y números.
ADMIN_EMAIL=
ADMIN_PASSWORD=
