# Copiar a .env (no se versiona) y completar. Las marcadas OBLIGATORIA no tienen valor por defecto:
# sin ellas docker compose no arranca. El resto es opcional (el valor indicado es el por defecto).

# --- Servidor ---
PUERTO=8090

# --- Base de datos (mysql-notificaciones) ---
# OBLIGATORIA: contraseña de root de MySQL (solo la usa el contenedor de la base)
MYSQL_ROOT_PASSWORD=
# Usuario de la aplicación (no puede ser root)
DB_USER=ticketya_notificaciones
# OBLIGATORIA: contraseña del usuario de la aplicación
DB_PASSWORD=
# URL JDBC: apunta a mysql-notificaciones dentro de ticketya-net
DB_URL=jdbc:mysql://mysql-notificaciones:3306/ticketya_notificaciones?serverTimezone=UTC
DB_DDL_AUTO=update

# --- Seguridad entre servicios ---
# OBLIGATORIA: token compartido (X-Service-Token), el mismo en todos los servicios.
# Sin él, /internal/** responde 403.
SERVICIO_TOKEN=

# --- SMTP (en desarrollo, un servidor de pruebas como Mailpit/MailHog) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USUARIO=
# Secreto: completar solo si el servidor SMTP pide autenticación
SMTP_CLAVE=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_TIMEOUT_CONEXION_MS=2000
SMTP_TIMEOUT_LECTURA_MS=5000
SMTP_REMITENTE=no-responder@ticketya.local

# --- Usuarios (MS6) ---
USUARIOS_URL=http://usuarios:8087
USUARIOS_TIMEOUT_CONEXION=2s
USUARIOS_TIMEOUT_LECTURA=5s

# --- Reintentos de envío ---
NOTIF_MAX_INTENTOS=5
NOTIF_ESPERA_BASE=30s
NOTIF_ESPERA_MAXIMA=1h

# --- Tareas de envío y recuperación ---
NOTIF_ENVIO_ACTIVO=true
NOTIF_ENVIO_INTERVALO=10s
NOTIF_ENVIO_LOTE=20
NOTIF_PLAZO_PROCESAMIENTO=2m
NOTIF_INTERVALO_RECUPERACION=60s
