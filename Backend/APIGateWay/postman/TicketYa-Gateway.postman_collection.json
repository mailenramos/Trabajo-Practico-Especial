{
  "info": {
    "_postman_id": "8ba1a513-9ac8-40b3-a755-9a7ca17e1667",
    "name": "TicketYa - API Gateway",
    "description": "Smoke tests manuales del API Gateway local. Importar junto con el environment TicketYa-Gateway-Local. Las solicitudes de negocio se envían al Gateway (8086), nunca a MS4. Completar los IDs del environment antes de ejecutar reserva/compra.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Consultas públicas",
      "item": [
        {
          "name": "Buscar eventos publicados",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Role", "value": "CLIENTE" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/eventos?page=0&size=10",
              "host": ["{{gatewayUrl}}"],
              "path": ["eventos"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "MS1. Se espera HTTP 200; el contenido depende de los eventos publicados en la base local."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El Gateway responde con HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"La respuesta es JSON\", function () { pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar lugares",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{organizerId}}" },
              { "key": "X-User-Role", "value": "ORGANIZADOR" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/lugares",
              "host": ["{{gatewayUrl}}"],
              "path": ["lugares"]
            },
            "description": "MS1. Consulta los lugares de ejemplo cargados por el perfil dev. Requiere el usuario organizador de prueba."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El Gateway responde con HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar detalle de evento",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Role", "value": "CLIENTE" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/eventos/{{eventoId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["eventos", "{{eventoId}}"]
            },
            "description": "MS1. Requiere un evento existente; completar eventoId en el environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El evento existe y la consulta respondió HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Identidad y allowlist",
      "item": [
        {
          "name": "MS3 rechaza consulta sin identidad",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{gatewayUrl}}/compras",
              "host": ["{{gatewayUrl}}"],
              "path": ["compras"]
            },
            "description": "Con MS3 levantado, valida que el Gateway no inventa X-User-Id y devuelve la respuesta 401 del servicio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"MS3 exige identidad (HTTP 401)\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ruta interna no publicada",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{gatewayUrl}}/internal/eventos/{{eventoId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["internal", "eventos", "{{eventoId}}"]
            },
            "description": "Debe responder con error de ruta y no alcanzar MS1; no se exige una forma de error específica."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La ruta interna no devuelve éxito\", function () { pm.expect(pm.response.code).to.be.at.least(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Método no permitido no publicado",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/eventos",
              "host": ["{{gatewayUrl}}"],
              "path": ["eventos"]
            },
            "description": "La allowlist no admite DELETE /eventos; no debe devolver éxito del microservicio."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El método no permitido no devuelve éxito\", function () { pm.expect(pm.response.code).to.be.at.least(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Reserva (requiere datos locales)",
      "item": [
        {
          "name": "Crear reserva temporal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"solicitudId\": \"{{solicitudId}}\",\n  \"detalles\": [\n    {\n      \"sectorId\": \"{{sectorId}}\",\n      \"fila\": {{fila}},\n      \"numero\": {{numero}}\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gatewayUrl}}/disponibilidad/eventos/{{eventoId}}/reservas",
              "host": ["{{gatewayUrl}}"],
              "path": ["disponibilidad", "eventos", "{{eventoId}}", "reservas"]
            },
            "description": "MS2. Requiere un evento publicado, con disponibilidad inicializada, un sector numerado disponible y los IDs/datos configurados. La reserva dura 10 minutos. Si la respuesta incluye reservaId, se guarda para el request siguiente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"La solicitud llegó a MS2 y no fue rechazada por el Gateway\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  var data = pm.response.json();",
                  "  if (data.reservaId) pm.environment.set(\"reservaId\", data.reservaId);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Compra y entradas (flujo opcional)",
      "item": [
        {
          "name": "Iniciar compra desde reserva",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Role", "value": "CLIENTE" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservaId\": \"{{reservaId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gatewayUrl}}/compras",
              "host": ["{{gatewayUrl}}"],
              "path": ["compras"]
            },
            "description": "MS3. Requiere reservaId vigente. MS3 consulta Eventos y Reservas directamente; esas dependencias deben estar disponibles. Si se crea la compra, guarda su id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"MS3 creó la compra (HTTP 201)\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "  var data = pm.response.json();",
                  "  if (data.id) pm.environment.set(\"compraId\", data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Pagar compra",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Role", "value": "CLIENTE" },
              { "key": "Idempotency-Key", "value": "{{paymentIdempotencyKey}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medioDePago\": \"CREDIT_CARD\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gatewayUrl}}/compras/{{compraId}}/pago",
              "host": ["{{gatewayUrl}}"],
              "path": ["compras", "{{compraId}}", "pago"]
            },
            "description": "MS3. Requiere compraId pendiente y MS1, MS2, MS4 y MS5 disponibles en sus URLs configuradas en MS3. La colección genera una clave de idempotencia nueva antes de cada envío."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"paymentIdempotencyKey\", \"gateway-\" + pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"MS3 resolvió el pago o lo dejó en curso\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 202]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar entradas del usuario",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Role", "value": "CLIENTE" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/entradas",
              "host": ["{{gatewayUrl}}"],
              "path": ["entradas"]
            },
            "description": "MS5. Si el pago se completó, permite consultar las entradas emitidas. Requiere MS5 disponible."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"MS5 responde HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8086" },
    { "key": "userId", "value": "cliente-demo" },
    { "key": "organizerId", "value": "organizador-demo" },
    { "key": "eventoId", "value": "" },
    { "key": "sectorId", "value": "" },
    { "key": "fila", "value": "1" },
    { "key": "numero", "value": "1" },
    { "key": "solicitudId", "value": "postman-reserva-demo" },
    { "key": "reservaId", "value": "" },
    { "key": "compraId", "value": "" },
    { "key": "paymentIdempotencyKey", "value": "" }
  ]
}
