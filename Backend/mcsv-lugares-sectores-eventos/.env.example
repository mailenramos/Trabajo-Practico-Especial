# Copiá este archivo como .env y completá los valores. El .env NO se sube al repo.
# Las variables con valor son los defaults del docker-compose.yml.

# --- Obligatoria (sin default: el contenedor no arranca sin ella) ---
# Token compartido que MS1 envía en X-Service-Token a otros servicios.
# Tiene que ser el mismo en todos los servicios del grupo.
SERVICIO_TOKEN=

# --- URLs de otros servicios ---
RESERVAS_BASE_URL=http://reservas:8080
COMPRAS_BASE_URL=http://compras:8083
PREFERENCIAS_BASE_URL=http://preferencias:8089
# MS6 (Usuarios): sin default hasta que el grupo defina el nombre del servicio en el compose general.
# Para probar con el stub: http://host.docker.internal:8087
USUARIOS_BASE_URL=

# --- Caché de la búsqueda pública ---
CATALOGO_CACHE_TTL=30s
CATALOGO_CACHE_MAXIMO_ENTRADAS=1000

# --- Tareas periódicas ---
OUTBOX_DISPATCHER_INTERVAL=60s
EVENTOS_FINALIZACION_INTERVAL=60s

# --- Aplicación ---
SPRING_PROFILES_ACTIVE=docker
PORT=8081