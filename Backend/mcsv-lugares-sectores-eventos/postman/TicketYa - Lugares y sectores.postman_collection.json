              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 201\", function () { pm.response.to.have.status(201); });\nvar json = pm.response.json();\nif (pm.response.code === 201) {\n  pm.collectionVariables.set(\"lugarId\", pm.response.json().id);\n}"
                ]
