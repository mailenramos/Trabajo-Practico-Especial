          },
          "response": []
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({ key: \"X-User-Id\", value: \"1\" });\r\npm.request.headers.upsert({ key: \"X-User-Roles\", value: \"ORGANIZADOR\" });"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Migración: X-User-Role (viejo) -> X-User-Roles (nuevo). Los requests \"[LEGACY]\" se dejan como están.\r",
          "const h = pm.request.headers;\r",
          "const esLegacy = pm.info.requestName.startsWith(\"[LEGACY]\");\r",
          "if (!esLegacy && h.has(\"X-User-Role\") && !h.has(\"X-User-Roles\")) {\r",
          "  h.upsert({ key: \"X-User-Roles\", value: h.get(\"X-User-Role\") });\r",
          "  h.remove(\"X-User-Role\");\r",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
