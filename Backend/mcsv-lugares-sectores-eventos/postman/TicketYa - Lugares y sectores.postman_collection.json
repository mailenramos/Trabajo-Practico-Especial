            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "1"
              },
              {
                "key": "X-User-Role",
                "value": "ADMIN"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teatro Central\",\n  \"direccion\": \"Av. Corrientes 1234\",\n  \"ciudad\": \"Buenos Aires\",\n  \"latitud\": -34.6037,\n  \"longitud\": -58.3816\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
