{
  "info": {
    "name": "TicketYa - Lugares y sectores",
    "description": "Casos de prueba del microservicio de gestión de lugares y sectores (cambio lugares-y-sectores). Ejecutar en orden: el request 01 guarda el id del lugar en la variable lugarId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "lugarId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Crear lugar válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 201\", function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.collectionVariables.set(\"lugarId\", json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-User-Id",
            "value": "1"
          },
          {
            "key": "X-User-Role",
            "value": "ADMIN"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/lugares",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "lugares"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teatro Central\",\n  \"direccion\": \"Av. Corrientes 1234\",\n  \"ciudad\": \"Buenos Aires\",\n  \"latitud\": -34.6037,\n  \"longitud\": -58.3816\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Guarda el id del lugar creado en la variable lugarId, que usan los requests siguientes."
      }
    },
