# Copiar a .env (no se versiona) y completar. Las marcadas OBLIGATORIA no tienen valor por defecto:
# sin ellas docker compose no arranca. El resto es opcional (el valor indicado es el por defecto).

# --- Base de datos (postgres-usuarios) ---
DB_USER=usuarios
# OBLIGATORIA: contraseña de la base (la usan el contenedor de PostgreSQL y la aplicación)
DB_PASSWORD=
# URL JDBC: apunta a postgres-usuarios dentro de ticketya-net
DB_URL=jdbc:postgresql://postgres-usuarios:5432/usuarios

# --- JWT ---
# OBLIGATORIA: secreto HS256, al menos 32 caracteres. El MISMO valor que usa el Gateway.
JWT_SECRET=
# Emisor (iss): el Gateway exige el mismo valor
JWT_ISSUER=ticketya-usuarios
# Vigencia del token (duración ISO-8601)
JWT_EXPIRATION=PT1H

# --- Administrador inicial (se crea solo si no hay ningún ADMIN activo) ---
# OBLIGATORIAS: sin ellas el servicio no arranca. La contraseña: 8+ caracteres, letras y números.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=TicketYa

# Crea un usuario de prueba por rol (contraseña Prueba123). Poner false fuera de desarrollo.
USUARIOS_DATOS_PRUEBA=true

# --- Seguridad entre servicios ---
# OBLIGATORIA en Docker: token compartido (X-Service-Token), el mismo en todos los servicios.
# Lo exige /internal/** (Notificaciones y Lugares, sectores y eventos lo envían).
SERVICIO_TOKEN=
