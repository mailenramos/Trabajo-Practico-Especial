{
  "info": {
    "_postman_id": "c1b4387b-6e17-4cb0-aeb9-2ef09a4db488",
    "name": "TicketYa - Preferencias (MS8)",
    "description": "Operaciones de preferencias, recomendaciones y avisos internos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8089"
    },
    {
      "key": "servicioToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Avisos internos",
      "item": [
        {
          "name": "Recibir evento publicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Service-Token",
                "value": "{{servicioToken}}"
              },
              {
                "key": "X-Aviso-Id",
                "value": "aviso-123",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": \"evento-123\",\n  \"nombre\": \"Concierto\",\n  \"tipo\": \"MUSICA\",\n  \"participantes\": [\"Artista de ejemplo\"],\n  \"ciudad\": \"Buenos Aires\",\n  \"fechaHora\": \"2030-01-02T03:04:05Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/internal/preferencias/eventos-publicados",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "internal",
                "preferencias",
                "eventos-publicados"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Obtener mis preferencias",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "cliente-123"
          },
          {
            "key": "X-User-Roles",
            "value": "CLIENTE"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/preferencias/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "preferencias",
            "me"
          ]
        }
      }
    },
    {
      "name": "Obtener mis recomendaciones",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "cliente-123"
          },
          {
            "key": "X-User-Roles",
            "value": "CLIENTE"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recomendaciones/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recomendaciones",
            "me"
          ]
        }
      }
    },
    {
      "name": "Reemplazar mis preferencias",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "cliente-123"
          },
          {
            "key": "X-User-Roles",
            "value": "CLIENTE"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tiposEvento\": [\"MUSICA\"],\n  \"artistas\": [\"Artista de ejemplo\"],\n  \"ciudades\": [\"Buenos Aires\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/preferencias/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "preferencias",
            "me"
          ]
        }
      }
    },
    {
      "name": "Eliminar mis preferencias",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-User-Id",
            "value": "cliente-123"
          },
          {
            "key": "X-User-Roles",
            "value": "CLIENTE"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/preferencias/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "preferencias",
            "me"
          ]
        }
      }
    }
  ]
}
