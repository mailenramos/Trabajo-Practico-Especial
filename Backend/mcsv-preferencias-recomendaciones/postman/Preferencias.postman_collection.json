{
  "info": {
    "_postman_id": "c1b4387b-6e17-4cb0-aeb9-2ef09a4db488",
    "name": "TicketYa - Preferencias (MS8)",
    "description": "Operaciones de preferencias, recomendaciones y avisos internos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8089"
    },
    {
      "key": "servicioToken",
      "value": ""
    },
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8086"
    },
    {
      "key": "tokenCliente",
      "value": ""
    },
    {
      "key": "tokenOrganizador",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Por el Gateway",
      "description": "Requiere el compose general y usuarios de prueba habilitados. Ejecutar primero ambos logins. El PUT reemplaza las preferencias del cliente. No exportar ni compartir los tokens obtenidos.",
      "item": [
        {
          "name": "Login cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('tokenCliente', '');"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.json().token;",
                  "  pm.test('El login devuelve token', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "  if (typeof token === 'string' && token) pm.collectionVariables.set('tokenCliente', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"correo\":\"cliente@ticketya.test\",\"password\":\"Prueba123\"}" },
            "url": "{{gatewayUrl}}/auth/login"
          }
        },
        {
          "name": "Login organizador",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('tokenOrganizador', '');"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.json().token;",
                  "  pm.test('El login devuelve token', () => pm.expect(token).to.be.a('string').and.not.empty);",
                  "  if (typeof token === 'string' && token) pm.collectionVariables.set('tokenOrganizador', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"correo\":\"organizador@ticketya.test\",\"password\":\"Prueba123\"}" },
            "url": "{{gatewayUrl}}/auth/login"
          }
        },
        {
          "name": "Consultar preferencias como cliente",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCliente}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/preferencias/me"
          }
        },
        {
          "name": "Reemplazar preferencias como cliente",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCliente}}", "type": "string" }] },
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"tiposEvento\":[\"MUSICA\"],\"artistas\":[\"Artista de ejemplo\"],\"ciudades\":[\"Buenos Aires\"]}" },
            "url": "{{gatewayUrl}}/preferencias/me"
          }
        },
        {
          "name": "Consultar recomendaciones como cliente",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenCliente}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/recomendaciones/me"
          }
        },
        {
          "name": "Consultar preferencias sin token",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 401', () => pm.response.to.have.status(401));"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/preferencias/me"
          }
        },
        {
          "name": "Consultar preferencias como organizador",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status 403', () => pm.response.to.have.status(403));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{tokenOrganizador}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/preferencias/me"
          }
        }
      ]
    },
    {
      "name": "Avisos internos",
      "item": [
        {
          "name": "Recibir evento publicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Service-Token",
                "value": "{{servicioToken}}"
              },
              {
                "key": "X-Aviso-Id",
                "value": "aviso-123",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": \"evento-123\",\n  \"nombre\": \"Concierto\",\n  \"tipo\": \"MUSICA\",\n  \"participantes\": [\"Artista de ejemplo\"],\n  \"ciudad\": \"Buenos Aires\",\n  \"fechaHora\": \"2030-01-02T03:04:05Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/internal/preferencias/eventos-publicados",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "internal",
                "preferencias",
                "eventos-publicados"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Obtener mis preferencias",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "cliente-123"
          },
          {
            "key": "X-User-Roles",
            "value": "CLIENTE"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/preferencias/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "preferencias",
            "me"
          ]
        }
      }
    },
    {
      "name": "Obtener mis recomendaciones",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "cliente-123"
          },
          {
            "key": "X-User-Roles",
            "value": "CLIENTE"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recomendaciones/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recomendaciones",
            "me"
          ]
        }
      }
    },
    {
      "name": "Reemplazar mis preferencias",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "cliente-123"
          },
          {
            "key": "X-User-Roles",
            "value": "CLIENTE"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tiposEvento\": [\"MUSICA\"],\n  \"artistas\": [\"Artista de ejemplo\"],\n  \"ciudades\": [\"Buenos Aires\"]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/preferencias/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "preferencias",
            "me"
          ]
        }
      }
    },
    {
      "name": "Eliminar mis preferencias",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-User-Id",
            "value": "cliente-123"
          },
          {
            "key": "X-User-Roles",
            "value": "CLIENTE"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/preferencias/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "preferencias",
            "me"
          ]
        }
      }
    }
  ]
}
