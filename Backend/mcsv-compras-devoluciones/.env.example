# Copiar a .env (no se versiona) y completar. Las marcadas OBLIGATORIA no tienen valor por defecto:
# sin ellas docker compose no arranca. El resto es opcional (el valor indicado es el por defecto).

# --- Base de datos (mysql-compras) ---
# OBLIGATORIA: contraseña de root de MySQL (solo la usa el contenedor de la base)
MYSQL_ROOT_PASSWORD=
# Usuario de la aplicación (no puede ser root)
DB_USER=ticketya_compras
# OBLIGATORIA: contraseña del usuario de la aplicación
DB_PASSWORD=
# URL JDBC: apunta a mysql-compras dentro de ticketya-net
DB_URL=jdbc:mysql://mysql-compras:3306/ticketya_compras?serverTimezone=UTC

# --- Seguridad entre servicios ---
# OBLIGATORIA: token compartido (X-Service-Token), el mismo en todos los servicios.
# Sin él, /internal/** responde 403 y Entradas/Notificaciones rechazan las llamadas de Compras.
SERVICIO_TOKEN=

# --- Otros servicios (nombres dentro de ticketya-net) ---
RESERVAS_URL=http://reservas:8080
EVENTOS_URL=http://lugares:8081
PAGOS_URL=http://pagos:8084
ENTRADAS_URL=http://entradas:8085
NOTIFICACIONES_URL=http://notificaciones:8090
