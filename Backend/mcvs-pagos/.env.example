# MS4 Pagos. Copiar a .env y completar DB_PASSWORD (obligatoria, sin valor por defecto).
SERVER_PORT=8084

# PostgreSQL (en Docker el host es el servicio pagos-db)
DB_HOST=pagos-db
DB_PORT=5432
DB_NAME=ticketya_payments
DB_USER=postgres
DB_PASSWORD=

# Simulador: APPROVED | REJECTED y SUCCESS | FAILURE
PAGOS_DECISION_PAGO=APPROVED
PAGOS_DECISION_REINTEGRO=SUCCESS

# Token compartido entre servicios (header X-Service-Token), mismo valor en todos.
SERVICIO_TOKEN=
# true: /internal/** exige X-Service-Token. Activar cuando Compras envíe el header a Pagos.
PAGOS_EXIGIR_TOKEN_SERVICIO=false

# Puertos del host solo para docker-compose.dev.yml
PAGOS_DEV_APP_PORT=8084
PAGOS_DEV_DB_PORT=5434
