  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Transversal: no responde 500', function () { pm.expect(pm.response.code).to.not.eql(500); });",
          "pm.test('Transversal: no expone datos de tarjeta', function () { pm.expect(pm.response.text()).to.not.match(/\\\"?(cardNumber|card|pan|cvv|cvc)\\\"?\\s*:/i); });",
          "pm.test('Transversal: errores con formato ApiError', function () { if (pm.response.code >= 400) { const body = pm.response.json(); pm.expect(body).to.have.property('timestamp'); pm.expect(body.status).to.eql(pm.response.code); pm.expect(body.error).to.be.a('string'); pm.expect(body.mensaje).to.be.a('string'); } });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "A1 Crear pago",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "K1-run2" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"purchaseId\": \"e1e1e1e1-e1e1-4e1e-8e1e-e1e1e1e1e1e1\",\n  \"amount\": 1500.00,\n  \"paymentMethod\": \"CREDIT_CARD\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/internal/pagos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('A1 status 201 y pago aprobado', function () { pm.response.to.have.status(201); const body = pm.response.json(); pm.expect(body.status).to.eql('APROBADO'); pm.expect(body.purchaseId).to.eql('e1e1e1e1-e1e1-4e1e-8e1e-e1e1e1e1e1e1'); pm.expect(body.amount).to.eql(1500); pm.expect(body.paymentMethod).to.eql('CREDIT_CARD'); pm.expect(body.id).to.be.a('string'); pm.collectionVariables.set('paymentId', body.id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "A2 Consultar pago creado",
      "request": { "method": "GET", "url": "{{baseUrl}}/internal/pagos/{{paymentId}}" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('A2 status 200 y mismos datos de A1', function () { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.id).to.eql(pm.collectionVariables.get('paymentId')); pm.expect(body.purchaseId).to.eql('e1e1e1e1-e1e1-4e1e-8e1e-e1e1e1e1e1e1'); pm.expect(body.amount).to.eql(1500); pm.expect(body.paymentMethod).to.eql('CREDIT_CARD'); pm.expect(body.status).to.eql('APROBADO'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "A3 Listar pagos por compra",
      "request": { "method": "GET", "url": "{{baseUrl}}/internal/pagos/compra/e1e1e1e1-e1e1-4e1e-8e1e-e1e1e1e1e1e1" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('A3 status 200 y contiene el pago A1', function () { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body).to.be.an('array'); pm.expect(body.some(function (p) { return p.id === pm.collectionVariables.get('paymentId') && p.status === 'APROBADO'; })).to.eql(true); });"
            ]
          }
        }
      ]
    },
