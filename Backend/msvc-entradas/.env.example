# Copiar a .env (no se versiona) y completar. Las marcadas OBLIGATORIA no tienen valor por defecto:
# sin ellas docker compose no arranca. El resto es opcional (el valor indicado es el por defecto).

# --- Base de datos (postgres-entradas) ---
DB_USER=entradas
# OBLIGATORIA: contraseña de la base (la usan el contenedor de PostgreSQL y la aplicación)
DB_PASSWORD=
# URL JDBC: apunta a postgres-entradas dentro de ticketya-net
DB_URL=jdbc:postgresql://postgres-entradas:5432/entradas

# --- Seguridad entre servicios ---
# OBLIGATORIA en Docker: token compartido (X-Service-Token), el mismo en todos los servicios.
# Lo exige /internal/** (Compras lo envía) y Entradas lo manda en su llamada a Lugares.
SERVICIO_TOKEN=

# --- Otros servicios (nombres dentro de ticketya-net) ---
# Lugares, sectores y eventos: autorización del personal de acceso en cada validación de QR
EVENTOS_URL=http://lugares:8081
# Tiempos máximos de esa consulta; si se exceden, la validación responde 503
EVENTOS_CONNECT_TIMEOUT=1s
EVENTOS_READ_TIMEOUT=2s
